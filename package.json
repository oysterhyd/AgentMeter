{
  "name": "codex-monitor",
  "version": "2.9.1",
  "description": "Native Go Windows Codex desktop and CLI usage monitor",
  "private": true,
  "author": "Codex Monitor",
  "scripts": {
    "dev": "node scripts/native.cjs start",
    "start": "node scripts/native.cjs start",
    "build": "node scripts/native.cjs build",
    "package": "node scripts/package.cjs",
    "package:check": "node scripts/installer-check.cjs",
    "test": "node scripts/native.cjs test",
    "test:pi": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test integrations/pi/codex-monitor.test.mjs",
    "test:ui": "npm run native:check",
    "native:start": "node scripts/native.cjs start",
    "native:build": "node scripts/native.cjs build",
    "native:test": "node scripts/native.cjs test",
    "native:check": "node scripts/native-check.cjs",
    "widget:check": "npm run native:check"
  }
}
